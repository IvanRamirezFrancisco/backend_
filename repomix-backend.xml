    private String productImage;

    // ==================== CANTIDAD Y PRECIOS ====================

    private Integer quantity;
    private BigDecimal price; // Precio unitario en el momento de la compra
    private BigDecimal subtotal; // quantity * price

    // ==================== MÉTODOS AUXILIARES ====================

