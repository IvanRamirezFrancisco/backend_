package com.security.service;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.time.LocalDateTime;
import java.util.*;
import java.util.regex.Pattern;

/**
 * Servicio de evaluación de vulnerabilidades de seguridad
 * Implementa análisis automatizado de XSS, SQL Injection y otras
 * vulnerabilidades
 */
@Service
public class VulnerabilityAssessmentService {

    private static final Logger logger = LoggerFactory.getLogger(VulnerabilityAssessmentService.class);

    @Value("${app.security.assessment.enabled:true}")
    private boolean assessmentEnabled;

    @Value("${app.security.assessment.sql-injection-patterns:true}")
    private boolean sqlInjectionCheck;

    @Value("${app.security.assessment.xss-patterns:true}")
    private boolean xssCheck;

    @Value("${app.security.assessment.dependency-check:true}")
    private boolean dependencyCheck;

    // Patrones de SQL Injection
    private static final Pattern[] SQL_INJECTION_PATTERNS = {
            Pattern.compile("(?i)(union|select|insert|update|delete|drop|create|alter|exec|execute)",
                    Pattern.CASE_INSENSITIVE),
            Pattern.compile("(?i)('|(\\-\\-)|(;)|(\\||\\|)|(\\*|\\*))", Pattern.CASE_INSENSITIVE),
            Pattern.compile("(?i)(or\\s+1\\s*=\\s*1|and\\s+1\\s*=\\s*1)", Pattern.CASE_INSENSITIVE),
            Pattern.compile("(?i)(having\\s+1\\s*=\\s*1|group\\s+by)", Pattern.CASE_INSENSITIVE),
            Pattern.compile("(?i)(information_schema|sysobjects|syscolumns)", Pattern.CASE_INSENSITIVE)
    };

    // Patrones de XSS
    private static final Pattern[] XSS_PATTERNS = {
            Pattern.compile("(?i)<script[^>]*>.*?</script>", Pattern.CASE_INSENSITIVE | Pattern.DOTALL),
            Pattern.compile("(?i)javascript:", Pattern.CASE_INSENSITIVE),
            Pattern.compile("(?i)on\\w+\\s*=", Pattern.CASE_INSENSITIVE),
            Pattern.compile("(?i)<iframe[^>]*>", Pattern.CASE_INSENSITIVE),
            Pattern.compile("(?i)<object[^>]*>", Pattern.CASE_INSENSITIVE),
            Pattern.compile("(?i)<embed[^>]*>", Pattern.CASE_INSENSITIVE),
            Pattern.compile("(?i)vbscript:", Pattern.CASE_INSENSITIVE),
            Pattern.compile("(?i)<link[^>]*>", Pattern.CASE_INSENSITIVE)
    };

    // Headers de seguridad requeridos
    private static final Map<String, String> REQUIRED_SECURITY_HEADERS = Map.of(
            "X-Content-Type-Options", "nosniff",
            "X-Frame-Options", "DENY",
            "X-XSS-Protection", "1; mode=block",
            "Strict-Transport-Security", "max-age=31536000; includeSubDomains",
            "Content-Security-Policy", "default-src 'self'",
            "Referrer-Policy", "strict-origin-when-cross-origin");

    /**
     * Ejecuta una evaluación completa de vulnerabilidades
     */
    public Map<String, Object> runFullAssessment() {
        Map<String, Object> results = new HashMap<>();

        try {
            logger.info("Starting comprehensive vulnerability assessment");

            if (sqlInjectionCheck) {
                results.put("sqlInjection", assessSqlInjectionVulnerabilities());
            }

            if (xssCheck) {
                results.put("xss", assessXssVulnerabilities());
            }

            results.put("securityHeaders", assessSecurityHeaders());
            results.put("authentication", assessAuthenticationSecurity());
            results.put("sessions", assessSessionSecurity());
            results.put("inputValidation", assessInputValidation());

            if (dependencyCheck) {
                results.put("dependencies", assessDependencyVulnerabilities());
            }

            results.put("timestamp", LocalDateTime.now().toString());
            results.put("overallRisk", calculateOverallRisk(results));

            logger.info("Vulnerability assessment completed");

        } catch (Exception e) {
            logger.error("Error during vulnerability assessment: {}", e.getMessage());
            results.put("error", e.getMessage());
        }

        return results;
    }

    /**
     * Evalúa vulnerabilidades de SQL Injection
     */
    private Map<String, Object> assessSqlInjectionVulnerabilities() {
        Map<String, Object> results = new HashMap<>();
        List<String> vulnerabilities = new ArrayList<>();
        List<String> testInputs = Arrays.asList(
                "' OR '1'='1",
                "'; DROP TABLE users; --",
                "1' UNION SELECT * FROM users--",
                "admin'--",
                "' OR 1=1#");

        try {
            for (String testInput : testInputs) {
                if (detectSqlInjectionPattern(testInput)) {
                    vulnerabilities.add("SQL Injection pattern detected: " + testInput);
                }
            }

            results.put("vulnerabilities", vulnerabilities);
            results.put("riskLevel", vulnerabilities.isEmpty() ? "LOW" : "HIGH");
            results.put("recommendation", vulnerabilities.isEmpty() ? "No SQL injection patterns detected"
                    : "Use parameterized queries and input validation");

        } catch (Exception e) {
            logger.error("Error assessing SQL injection vulnerabilities: {}", e.getMessage());
            results.put("error", e.getMessage());
        }

        return results;
    }

    /**
     * Evalúa vulnerabilidades XSS
     */
    private Map<String, Object> assessXssVulnerabilities() {
        Map<String, Object> results = new HashMap<>();
        List<String> vulnerabilities = new ArrayList<>();
        List<String> testInputs = Arrays.asList(
                "<script>alert('XSS')</script>",
                "<img src='x' onerror='alert(1)'>",
                "javascript:alert('XSS')",
                "<iframe src='javascript:alert(1)'></iframe>",
                "<svg onload='alert(1)'>");

        try {
            for (String testInput : testInputs) {
                if (detectXssPattern(testInput)) {
                    vulnerabilities.add("XSS pattern detected: " + testInput);
                }
            }

            results.put("vulnerabilities", vulnerabilities);
            results.put("riskLevel", vulnerabilities.isEmpty() ? "LOW" : "HIGH");
            results.put("recommendation", vulnerabilities.isEmpty() ? "No XSS patterns detected"
                    : "Implement proper input sanitization and output encoding");

        } catch (Exception e) {
            logger.error("Error assessing XSS vulnerabilities: {}", e.getMessage());
            results.put("error", e.getMessage());
        }

        return results;
    }

    /**
     * Evalúa cabeceras de seguridad
     */
    private Map<String, Object> assessSecurityHeaders() {
        Map<String, Object> results = new HashMap<>();
        List<String> missingHeaders = new ArrayList<>();
        List<String> recommendations = new ArrayList<>();

        try {
            // Simular verificación de headers (en un entorno real consultarías el servidor)
            for (Map.Entry<String, String> header : REQUIRED_SECURITY_HEADERS.entrySet()) {
                // Aquí implementarías la lógica real de verificación de headers
                // Por ahora, simulo que algunos headers están presentes
                if (!isHeaderPresent(header.getKey())) {
                    missingHeaders.add(header.getKey());
                    recommendations.add("Add header: " + header.getKey() + ": " + header.getValue());
                }
            }

            results.put("missingHeaders", missingHeaders);
            results.put("recommendations", recommendations);
            results.put("riskLevel", missingHeaders.isEmpty() ? "LOW" : "MEDIUM");

        } catch (Exception e) {
            logger.error("Error assessing security headers: {}", e.getMessage());
            results.put("error", e.getMessage());
        }

        return results;
    }

    /**
     * Evalúa seguridad de autenticación
     */
    private Map<String, Object> assessAuthenticationSecurity() {
        Map<String, Object> results = new HashMap<>();
        List<String> issues = new ArrayList<>();
        List<String> recommendations = new ArrayList<>();

        try {
            // Verificar configuraciones de autenticación
            if (!isPasswordPolicyStrong()) {
                issues.add("Weak password policy");
                recommendations.add("Implement strong password requirements");
            }

            if (!isTwoFactorEnabled()) {
                issues.add("Two-factor authentication not enforced");
                recommendations.add("Enable 2FA for all users");
            }

            if (!isAccountLockoutConfigured()) {
                issues.add("Account lockout not configured");
                recommendations.add("Configure account lockout after failed attempts");
            }

            results.put("issues", issues);
            results.put("recommendations", recommendations);
            results.put("riskLevel", issues.isEmpty() ? "LOW" : "MEDIUM");

        } catch (Exception e) {
            logger.error("Error assessing authentication security: {}", e.getMessage());
            results.put("error", e.getMessage());
        }

        return results;
    }

    /**
     * Evalúa seguridad de sesiones
     */
    private Map<String, Object> assessSessionSecurity() {
        Map<String, Object> results = new HashMap<>();
        List<String> issues = new ArrayList<>();
        List<String> recommendations = new ArrayList<>();

        try {
            // Verificar configuración de sesiones
            if (!isSessionTimeoutConfigured()) {
                issues.add("Session timeout not configured");
                recommendations.add("Set appropriate session timeout");
            }

            if (!areSessionCookiesSecure()) {
                issues.add("Session cookies not secure");
                recommendations.add("Set HttpOnly, Secure, and SameSite attributes");
            }

            if (!isSessionFixationProtected()) {
                issues.add("Session fixation protection not enabled");
                recommendations.add("Enable session fixation protection");
            }

            results.put("issues", issues);
            results.put("recommendations", recommendations);
            results.put("riskLevel", issues.isEmpty() ? "LOW" : "MEDIUM");

        } catch (Exception e) {
            logger.error("Error assessing session security: {}", e.getMessage());
            results.put("error", e.getMessage());
        }

        return results;
    }

    /**
     * Evalúa validación de entrada
     */
    private Map<String, Object> assessInputValidation() {
        Map<String, Object> results = new HashMap<>();
        List<String> issues = new ArrayList<>();
        List<String> recommendations = new ArrayList<>();

        try {
            // Verificar validación de entrada
            if (!isInputValidationImplemented()) {
                issues.add("Input validation not comprehensive");
                recommendations.add("Implement comprehensive input validation");
            }

            if (!isOutputEncodingImplemented()) {
                issues.add("Output encoding not implemented");
                recommendations.add("Implement proper output encoding");
            }

            results.put("issues", issues);
            results.put("recommendations", recommendations);
            results.put("riskLevel", issues.isEmpty() ? "LOW" : "HIGH");

        } catch (Exception e) {
            logger.error("Error assessing input validation: {}", e.getMessage());
            results.put("error", e.getMessage());
        }

        return results;
    }

    /**
     * Evalúa vulnerabilidades en dependencias
     */
    private Map<String, Object> assessDependencyVulnerabilities() {
        Map<String, Object> results = new HashMap<>();
        List<String> vulnerableDependencies = new ArrayList<>();
        List<String> recommendations = new ArrayList<>();

        try {
            // Ejecutar Maven dependency check (simplificado)
            String mavenOutput = runMavenDependencyCheck();
            if (mavenOutput.contains("vulnerability") || mavenOutput.contains("CVE")) {
                vulnerableDependencies.add("Vulnerable dependencies found - check Maven output");
                recommendations.add("Update vulnerable dependencies to latest secure versions");
            }

            results.put("vulnerableDependencies", vulnerableDependencies);
            results.put("recommendations", recommendations);
            results.put("riskLevel", vulnerableDependencies.isEmpty() ? "LOW" : "HIGH");

        } catch (Exception e) {
            logger.error("Error assessing dependency vulnerabilities: {}", e.getMessage());
            results.put("error", e.getMessage());
        }

        return results;
    }

    /**
     * Detecta patrones de SQL Injection
     */
    private boolean detectSqlInjectionPattern(String input) {
        if (input == null)
            return false;

        for (Pattern pattern : SQL_INJECTION_PATTERNS) {
            if (pattern.matcher(input).find()) {
                return true;
            }
        }
        return false;
    }

    /**
     * Detecta patrones XSS
     */
    private boolean detectXssPattern(String input) {
        if (input == null)
            return false;

        for (Pattern pattern : XSS_PATTERNS) {
            if (pattern.matcher(input).find()) {
                return true;
            }
        }
        return false;
    }

    /**
     * Calcula el riesgo general
     */
    private String calculateOverallRisk(Map<String, Object> results) {
        int highRisks = 0;
        int mediumRisks = 0;

        for (Object result : results.values()) {
            if (result instanceof Map) {
                @SuppressWarnings("unchecked")
                Map<String, Object> assessment = (Map<String, Object>) result;
                String riskLevel = (String) assessment.get("riskLevel");
                if ("HIGH".equals(riskLevel)) {
                    highRisks++;
                } else if ("MEDIUM".equals(riskLevel)) {
                    mediumRisks++;
                }
            }
        }

        if (highRisks > 0)
            return "HIGH";
        if (mediumRisks > 2)
            return "MEDIUM";
        return "LOW";
    }

