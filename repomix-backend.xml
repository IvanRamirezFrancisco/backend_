    private void testInvalidNames(Validator validator) {
        System.out.println("Probando nombres INVÁLIDOS (ataques de seguridad):");

        String[] invalidNames = {
                "<script>alert('xss')</script>", // XSS
                "DROP TABLE users", // SQL Injection
                "John123", // Números
                "user@domain.com", // Símbolos
