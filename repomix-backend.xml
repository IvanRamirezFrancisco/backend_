 * @param errorMessage       mensaje de error si status = ERROR, null en otro
 *                           caso
 */
public record MaintenanceLogDto(
        Long id,
        String operation,
        String targetName,
        String targetType,
        String executedBy,
        LocalDateTime executedAt,
        String executedAtRelative,
        Integer rowsBefore,
        Integer rowsAfter,
        Integer rowsAffected,
        Integer durationMs,
        String status,
        String errorMessage) {
}
