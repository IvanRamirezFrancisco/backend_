        return rolesDetail;
    }

    public void setRolesDetail(Set<RoleDTO> rolesDetail) {
        this.rolesDetail = rolesDetail;
    }

    // ==================== Nested DTO ====================

    /**
     * DTO simplificado de Role para incluir en la respuesta
     */
